# =============================================================================
# University Administration Management System (UAMS) - Environment Config
# =============================================================================

# Application
NEXT_PUBLIC_APP_NAME="University Administration Management System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase (PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database Connection (Direct & Pooled)
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# JWT & Authentication Secret
JWT_SECRET="your-super-secret-jwt-signing-key-minimum-32-characters"

# Safaricom Daraja M-Pesa API
MPESA_ENVIRONMENT="sandbox" # sandbox or production
MPESA_CONSUMER_KEY="your_mpesa_consumer_key"
MPESA_CONSUMER_SECRET="your_mpesa_consumer_secret"
MPESA_SHORTCODE="your_approved_shortcode"
NEXT_PUBLIC_MPESA_SHORTCODE="your_approved_shortcode"
MPESA_PASSKEY="your_daraja_passkey"
MPESA_CALLBACK_URL="https://your-domain.com/api/v1/finance/mpesa/callback"
MPESA_CALLBACK_SECRET="replace-with-a-random-secret-at-least-32-characters"
ENABLE_DEMO_AUTH="false"
NEXT_PUBLIC_ENABLE_DEMO_AUTH="false"

# Bank Integration Configuration (Optional / Sandbox)
BANK_INTEGRATION_MODE="manual" # manual or api
BANK_API_KEY=""
BANK_API_ENDPOINT=""

# Messaging Dispatcher (A3) - SMS & Email
# No keys set = MOCK mode: messages are simulated inside UAMS only (safe for dev/demo).
# Africa's Talking SMS (username "sandbox" or AT_SANDBOX=1 uses the sandbox host)
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID=""
AT_SANDBOX="0"
# Transactional email - Resend (first choice) or SMTP via nodemailer
RESEND_KEY=""
EMAIL_FROM="UAMS <no-reply@university.ac.ke>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="0"
