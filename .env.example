# =============================================================================
# University Administration Management System (UAMS) - Environment Config
# =============================================================================

# Application
NEXT_PUBLIC_APP_NAME="University Administration Management System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase (PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database Connection (Direct & Pooled)
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# JWT & Authentication Secret
JWT_SECRET="your-super-secret-jwt-signing-key-minimum-32-characters"

# Safaricom Daraja M-Pesa API
MPESA_ENVIRONMENT="sandbox" # sandbox or production
MPESA_CONSUMER_KEY="your_mpesa_consumer_key"
MPESA_CONSUMER_SECRET="your_mpesa_consumer_secret"
MPESA_SHORTCODE="522533"
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_CALLBACK_URL="https://your-domain.com/api/v1/finance/mpesa/callback"

# Bank Integration Configuration (Optional / Sandbox)
BANK_INTEGRATION_MODE="manual" # manual or api
BANK_API_KEY=""
BANK_API_ENDPOINT=""
